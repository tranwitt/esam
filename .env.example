# Copy to .env and edit. Every value shown is the default.
# The environment profiles (config/environments/<name>.yaml) read these same
# variables: a profile line `something_env: ESAM_X` means "use ESAM_X from here
# when it is set". Check the result with:  python -m esamkit.environment

# ── Which profile ────────────────────────────────────────────
# ESAM_ENV=local                         # local | pilot-il5 | full-janusgraph (or --env on the command line)

# ── Embeddings: WHICH model, and WHERE it runs ───────────────
# ESAM_EMBED_MODEL     the embedding model.
#                        local:    its Hugging Face id (staged once by lessons/00_setup/stage_model.py)
#                        endpoint: the model name the endpoint serves
# ESAM_EMBED_BASE_URL  the FULL URL of an OpenAI-compatible embeddings endpoint, e.g. https://host/v1/embeddings.
#                        It is used exactly as written: nothing is appended to it.
#                        unset = the model runs on this machine, from ESAM_EMBED_MODEL_DIR.
# Setting the URL switches to the endpoint; no other change is needed.
# Check what is in effect:  python -m esamkit.environment
# Changing the model means re-embedding everything (lesson 03 with --reset).
ESAM_EMBED_MODEL=BAAI/bge-base-en-v1.5
# ESAM_EMBED_MODEL_DIR=models/bge-base-en-v1.5   # default: models/<last part of the model name>

# An endpoint instead of the local model. Examples:
#   Ollama:           ESAM_EMBED_BASE_URL=http://127.0.0.1:11434/v1/embeddings   ESAM_EMBED_MODEL=nomic-embed-text
#   TEI / vLLM:       ESAM_EMBED_BASE_URL=http://embeddings.internal:8080/v1/embeddings   ESAM_EMBED_MODEL=BAAI/bge-base-en-v1.5
#   OpenAI / gateway: ESAM_EMBED_BASE_URL=https://api.openai.com/v1/embeddings   ESAM_EMBED_MODEL=text-embedding-3-small
# ESAM_EMBED_BASE_URL=https://gateway.example/v1/embeddings
# ESAM_EMBED_API_KEY=                     # unset + same host as the reasoning URL = the reasoning key is sent
# ESAM_EMBED_DIMENSIONS=0                # shorter vectors, for models that support it (0 = the model's own size)
# ESAM_EMBED_BATCH_SIZE=64               # texts per request
# ESAM_EMBED_QUERY_PREFIX=auto           # auto = by model family (BGE, E5); none = send text unchanged
# ESAM_EMBED_DOC_PREFIX=auto
# ESAM_EMBED_BACKEND=                    # local | openai. Normally left unset: it follows from the URL.
# (Older names still read: ESAM_EMBED_MODEL_ID, ESAM_OPENAI_BASE_URL, ESAM_OPENAI_API_KEY, ESAM_OPENAI_EMBED_MODEL.)

# ── Vector store ─────────────────────────────────────────────
# ESAM_VECTOR_BACKEND=pgvector           # lessons only; under a profile, vector.backend decides
ESAM_COLLECTION=esam_documents
# Default = local docker-compose database. On the pilot: VM-1 host, port 5432.
ESAM_PG_DSN=postgresql://esam_user:esam_local_only@127.0.0.1:5433/esam_pilot

# Used by docker-compose.yml (must match the DSN above)
ESAM_PG_USER=esam_user
ESAM_PG_PASSWORD=esam_local_only
ESAM_PG_DB=esam_pilot

# ── Chunking (characters) ────────────────────────────────────
ESAM_CHUNK_SIZE=600
ESAM_CHUNK_OVERLAP=80

# ── Models: one endpoint per role ────────────────────────────
# Each role has its OWN url, key, model and API. The profiles in
# config/environments/*.yaml name exactly these variables, so what you set
# here is what the crew, the lessons and the probes use.
#   python -m esamkit.environment      shows the model and URL in effect per role
#
# REASONING: reads, answers, reviews (lessons 05/06 and all the crew's agents).
# ESAM_REASONING_BASE_URL=https://api.openai.com/v1   # local profile default; the pilot profiles have none
# ESAM_REASONING_API_KEY=
# ESAM_REASONING_MODEL=gpt-5.1
# Which API the endpoint speaks: chat (/chat/completions), responses (/responses),
# or auto (chat first, then responses on the same endpoint if chat fails).
# ESAM_REASONING_API=chat
# Fallback endpoints, tried in order when a call fails. Each field defaults to the
# primary's, so one line is enough. Number them 1, 2, 3 ...
# ESAM_REASONING_FALLBACK_1_API=responses
# ESAM_REASONING_FALLBACK_2_BASE_URL=https://second-gateway.example/v1
# ESAM_REASONING_FALLBACK_2_API_KEY=
# ESAM_REASONING_FALLBACK_2_MODEL=
#
# CODING: the model approved for writing code. Separate from reasoning: nothing
# is shared, so give it its own URL and key even when both use one gateway.
# No ESAM_CODING_MODEL = no coding model (the pilot profiles default it to nemotron-4-15b).
# ESAM_CODING_BASE_URL=https://code-gateway.example/v1
# ESAM_CODING_API_KEY=
# ESAM_CODING_MODEL=
# ESAM_CODING_API=chat
# ESAM_CODING_FALLBACK_1_BASE_URL=        # same pattern as ESAM_REASONING_FALLBACK_n_*
#
# ESAM_LLM_TIMEOUT=120                   # seconds per call
# ESAM_LLM_FAILOVER_COOLDOWN=300         # seconds a failed endpoint is skipped
# (Older names still read: ESAM_CHAT_* for ESAM_REASONING_*; ESAM_GATEWAY_URL and
#  ESAM_GATEWAY_KEY for the reasoning and coding URL and key when those are not set.)

# ── Documents: Word files and picture diagrams ───────────────
# .md, .txt, .docx, .doc, .rtf and pictures (.png .jpg .gif .webp .bmp .tif .svg) can be ingested.
# A legacy .doc is read with LibreOffice when it is installed, otherwise by the built-in reader.
# ESAM_DOC_CONVERTER=auto                # auto | libreoffice | builtin
# ESAM_SOFFICE=/path/to/soffice          # if LibreOffice is not on PATH
# Diagrams (pictures in a document, or picture files) are turned into searchable text:
#   auto  = a vision model describes them if ESAM_VISION_MODEL is set; otherwise local text only
#   local = never send a picture to a model (SVG labels, OCR if tesseract is installed)
#   off   = keep only the picture's name and caption
# ESAM_DIAGRAMS=auto                     # (the pilot profiles default to local)
# ESAM_VISION_MODEL=gpt-5.1              # unset = no picture leaves this machine
# ESAM_VISION_BASE_URL=                  # default: the reasoning URL
# ESAM_VISION_API_KEY=                   # default: the reasoning key
# ESAM_VISION_API=                       # default: the reasoning API
# ESAM_VISION_FALLBACK_1_BASE_URL=       # same pattern as ESAM_REASONING_FALLBACK_n_*
# ESAM_DIAGRAM_CACHE_DIR=work/cache/diagrams

# ── Graph ────────────────────────────────────────────────────
# ESAM_GRAPH_BACKEND=postgres            # lessons only; under a profile, graph.backend decides
# ESAM_GRAPH_DSN=                        # default: ESAM_PG_DSN
# ESAM_GREMLIN_URL=ws://janusgraph-host:8182/gremlin    # full-janusgraph profile

# ── Data locations ───────────────────────────────────────────
# ESAM_BASELINE_YAML=data/baseline/vehicle_decomposition.yaml
# ESAM_DOCUMENTS_DIR=data/documents
# ESAM_ONTOLOGY_YAML=data/ontology/esam_ontology.yaml
