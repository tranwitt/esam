# Copy to .env and edit. Every value shown is the default.

# ── Embeddings: WHICH model, and WHERE it runs ───────────────
# ESAM_EMBED_MODEL     the embedding model.
#                        local:    its Hugging Face id (staged once by lessons/00_setup/stage_model.py)
#                        endpoint: the model name the endpoint serves
# ESAM_EMBED_BASE_URL  the URL of an OpenAI-compatible embeddings endpoint (ESAM posts to <URL>/embeddings).
#                        unset = the model runs on this machine, from ESAM_EMBED_MODEL_DIR.
# Setting the URL switches to the endpoint; no other change is needed.
# Check what is in effect:  python -m esamkit.environment
# Changing the model means re-embedding everything (lesson 03 with --reset).
ESAM_EMBED_MODEL=BAAI/bge-base-en-v1.5
# ESAM_EMBED_MODEL_DIR=models/bge-base-en-v1.5   # default: models/<last part of the model name>

# An endpoint instead of the local model. Examples:
#   Ollama:           ESAM_EMBED_BASE_URL=http://127.0.0.1:11434/v1   ESAM_EMBED_MODEL=nomic-embed-text
#   TEI / vLLM:       ESAM_EMBED_BASE_URL=http://embeddings.internal:8080/v1   ESAM_EMBED_MODEL=BAAI/bge-base-en-v1.5
#   OpenAI / gateway: ESAM_EMBED_BASE_URL=https://api.openai.com/v1   ESAM_EMBED_MODEL=text-embedding-3-small
# ESAM_EMBED_BASE_URL=https://gateway.example/v1
# ESAM_EMBED_API_KEY=
# ESAM_EMBED_DIMENSIONS=0                # shorter vectors, for models that support it (0 = the model's own size)
# ESAM_EMBED_BATCH_SIZE=64               # texts per request
# ESAM_EMBED_QUERY_PREFIX=auto           # auto = by model family (BGE, E5); none = send text unchanged
# ESAM_EMBED_DOC_PREFIX=auto
# ESAM_EMBED_BACKEND=                    # local | openai. Normally left unset: it follows from the URL.
# (Older names still read: ESAM_EMBED_MODEL_ID, ESAM_OPENAI_BASE_URL, ESAM_OPENAI_API_KEY, ESAM_OPENAI_EMBED_MODEL.)

# ── Vector store ─────────────────────────────────────────────
ESAM_VECTOR_BACKEND=pgvector
ESAM_COLLECTION=esam_documents
# Default = local docker-compose database. On the pilot: VM-1 host, port 5432.
ESAM_PG_DSN=postgresql://esam_user:esam_local_only@127.0.0.1:5433/esam_pilot

# Used by docker-compose.yml (must match the DSN above)
ESAM_PG_USER=esam_user
ESAM_PG_PASSWORD=esam_local_only
ESAM_PG_DB=esam_pilot

# ── Chunking (characters) ────────────────────────────────────
ESAM_CHUNK_SIZE=600
ESAM_CHUNK_OVERLAP=80

# ── Chat model (lesson 05, lesson 06; the crew takes its model from the profile) ──
# ESAM_CHAT_BASE_URL=https://api.openai.com/v1
# ESAM_CHAT_API_KEY=
# ESAM_CHAT_MODEL=gpt-5.1
# Which API the endpoint speaks: chat (/chat/completions), responses (/responses),
# or auto (chat first, then responses on the same endpoint if chat fails).
# ESAM_CHAT_API=chat
# Fallback endpoints, tried in order when a call fails. Each field defaults to the
# primary's, so one line is enough. Number them 1, 2, 3 ...
# ESAM_CHAT_FALLBACK_1_API=responses
# ESAM_CHAT_FALLBACK_2_BASE_URL=https://second-gateway.example/v1
# ESAM_CHAT_FALLBACK_2_API_KEY=
# ESAM_CHAT_FALLBACK_2_MODEL=
# ESAM_LLM_TIMEOUT=120                   # seconds per call
# ESAM_LLM_FAILOVER_COOLDOWN=300         # seconds a failed endpoint is skipped
# For the crew, the same is set per role in config/environments/<profile>.yaml
# (llm.roles.reasoning.api and .fallbacks).

# ── Documents: Word files and picture diagrams ───────────────
# .md, .txt, .docx, .doc, .rtf and pictures (.png .jpg .gif .webp .bmp .tif .svg) can be ingested.
# A legacy .doc is read with LibreOffice when it is installed, otherwise by the built-in reader.
# ESAM_DOC_CONVERTER=auto                # auto | libreoffice | builtin
# ESAM_SOFFICE=/path/to/soffice          # if LibreOffice is not on PATH
# Diagrams (pictures in a document, or picture files) are turned into searchable text:
#   auto  = a vision model describes them if ESAM_VISION_MODEL is set; otherwise local text only
#   local = never send a picture to a model (SVG labels, OCR if tesseract is installed)
#   off   = keep only the picture's name and caption
# ESAM_DIAGRAMS=auto
# ESAM_VISION_MODEL=gpt-5.1              # unset = no picture leaves this machine
# ESAM_VISION_BASE_URL=                  # default: ESAM_CHAT_BASE_URL
# ESAM_VISION_API_KEY=                   # default: ESAM_CHAT_API_KEY
# ESAM_VISION_API=                       # default: ESAM_CHAT_API
# ESAM_VISION_FALLBACK_1_BASE_URL=       # same pattern as ESAM_CHAT_FALLBACK_n_*
# ESAM_DIAGRAM_CACHE_DIR=work/cache/diagrams
